# Clerk (Google OAuth only; configure Google as the only enabled strategy in Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# NumberPanel — server-side only; never use a NEXT_PUBLIC_ prefix
NUMBERPANEL_API_KEY=replace_with_your_numberpanel_api_key
NUMBERPANEL_API_BASE_URL=https://numberpanel.tech

# Turso (libSQL) for per-user resource ownership and rate limits — server-side only
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=replace_with_your_turso_auth_token
# Local development/tests may use TURSO_DATABASE_URL=file:local.db with no token

# Clerk user ID of the sole application owner (find it in Clerk Dashboard > Users)
OWNER_CLERK_USER_ID=user_replace_me
